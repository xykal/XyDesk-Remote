rules_version = '2';

// Chat Global XyDesk di Firestore.
// Prinsip: klien TIDAK PERNAH menulis pesan langsung. Semua kirim/edit/hapus
// lewat Cloud Functions (Admin SDK) yang memvalidasi identitas GitHub,
// moderasi, dan rate-limit — sama seperti Durable Object saat ini.
service cloud.firestore {
  match /databases/{database}/documents {

    // Pesan ruang global: baca untuk user login, tulis hanya server (Functions).
    match /rooms/global/messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pin ruang global: baca user login, tulis hanya server.
    match /rooms/global/meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Profil pengguna: hanya pemilik dokumen yang boleh menulis profilnya.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Leaderboard: baca user login, tulis hanya server (aggregator Functions).
    match /leaderboard/{authorKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
