# Template variabel lingkungan — XyDesk-Remote / XyVerse
# JANGAN isi file ini dengan nilai asli. Salin ke `.env` di root project,
# lalu isi secara lokal. `.env` sudah ada di .gitignore repo.
# Semua nilai di bawah adalah PLACEHOLDER — gunakan secret manager / CI Secrets
# untuk nilai produksi. Rotasi kunci lama sebelum memakai template ini.

# --- Email (Resend) ---
RESEND_EMAIL_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
RESEND_STOK_KE_2_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# --- Media (Cloudinary / TwicPics) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=XXXXXXXXXXXXXXXXXXXX
TWICPICS_API_KEY=XXXXXXXXXXXXXXXXXXXX

# --- Google OAuth ---
GOOGLE_OAUTH_XYDESK_APK=XXXXXXXXXXXX-xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_XYDESK_WEB=XXXXXXXXXXXX-xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_XYCLOUDSTORE_ANDROID=XXXXXXXXXXXX-xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_XYCLOUDSTORE_WEB=XXXXXXXXXXXX-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=XXXXXXXXXXXX-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_WEB=GOCSPX-XXXXXXXXXXXXXXXXXXXX
GOOGLE_CLIENT_ID_RILISIN=XXXXXXXXXXXX-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_RILISIN=GOCSPX-XXXXXXXXXXXXXXXXXXXX
GOOGLE_PROJECT_ID_RILISIN=your-gcp-project-id
GOOGLE_REDIRECT_URI_RILISIN=https://example.com/oauth/callback

# --- Cloudflare ---
# Satu token per akun. Jangan pernah menyisipkan token polos tanpa nama variabel.
CLOUDFLARE_API_TOKEN=XXXXXXXXXXXXXXXXXXXX
CLOUDFLARE_API_TOKEN_SECOND_ACCOUNT=XXXXXXXXXXXXXXXXXXXX

# --- GitHub ---
# Gunakan fine-grained PAT dengan scope minimum + expiry; lebih baik lagi: tidak
# disimpan lokal sama sekali dan hanya lewat GitHub Actions Secrets.
GITHUB_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXX
GITHUB_USERNAME=your-github-username

# --- Vercel ---
VERCEL_TOKEN=XXXXXXXXXXXXXXXXXXXX

# --- OneSignal ---
ONESIGNAL_XYCLOUDSTORE_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_XYCLOUDSTORE_API_KEY=os_v2_app_XXXXXXXXXXXXXXXXXXXX
ONESIGNAL_XYDESK_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_XYDESK_API_KEY=os_v2_app_XXXXXXXXXXXXXXXXXXXX

# --- Pembayaran (Pakasir) ---
PAKASIR_PROJECT=your-project-slug
PAKASIR_API_KEY=XXXXXXXXXXXXXXXXXXXX

# --- xAI / Grok ---
GROK_APKXYSTUDIO_API_KEY=XXXXXXXXXXXXXXXXXXXX
GROK_XYCLOUDSTORE_API_KEY=XXXXXXXXXXXXXXXXXXXX

# --- Tailscale ---
TAILSCALE_AUTH_KEY=tskey-auth-XXXXXXXXXXXXXXXXXXXX

# --- Branding ---
XYVERSE_LOGO_PACK_URL=https://example.com/assets/logo-pack.zip
XYVERSE_BRAND_KIT_FILE_ID=XXXXXXXXXXXXXXXXXXXX
XYVERSE_BRAND_KIT_LOCAL_PATH=/absolute/local/path/to/brand-kit

# --- Release signing (lihat docs/BUILD.md) ---
RELEASE_STORE_FILE=/absolute/local/path/to/release.jks
RELEASE_STORE_PASSWORD=XXXXXXXXXXXXXXXXXXXX
RELEASE_KEY_ALIAS=your-key-alias
RELEASE_KEY_PASSWORD=XXXXXXXXXXXXXXXXXXXX
