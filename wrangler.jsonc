{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xydesk-remote-web",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "routes": [
    { "pattern": "rdp.xydesk.my.id", "custom_domain": true },
    { "pattern": "xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "www.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "api.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "wss.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "cpc.xydeskremote.biz.id", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "UNIQUE_DOWNLOADS", "id": "909d51530b7d4e6b8ada61ec59a3e3d3" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACTIVE_SESSIONS", "class_name": "ActiveSessions" },
      { "name": "COMMUNITY_JOKES", "class_name": "CommunityJokes" },
      { "name": "PC_SIGNAL_ROOMS", "class_name": "PcSignalRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ActiveSessions"] },
    { "tag": "v2", "new_sqlite_classes": ["CommunityJokes"] },
    { "tag": "v3", "new_sqlite_classes": ["PcSignalRoom"] }
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/arm64-v8a.apk",
      "/armeabi-v7a.apk",
      "/x86_64.apk",
      "/SHA256SUMS.txt",
      "/XyDesk-Remote-Host-Agent-win64.zip",
      "/XyDeskRemoteHost.exe",
      "/xydesk_quic.dll",
      "/xydesk_host_core.dll",
      "/XyDesk-x64.exe",
      "/XyDesk-x64.msi",
      "/XyDesk-Remote-arm64-v8a.apk",
      "/XyDesk-Remote-armeabi-v7a.apk",
      "/XyDesk-Remote-x86_64.apk",
      "/XyDesk-arm64-v8a.apk",
      "/XyDesk-armeabi-v7a.apk",
      "/XyDesk.apk",
      "/_qa/*",
      "/host",
      "/host.ps1",
      "/agent.ps1",
      "/agent.bat",
      "/XyDeskHost-Setup.bat"
    ]
  }
}
