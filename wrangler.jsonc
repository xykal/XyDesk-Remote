{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xydesk-remote-web",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "vars": {
    "ONESIGNAL_APP_ID": "e3d5adea-1c0f-4986-9ce5-e088d65f0998"
  },
  "routes": [
    { "pattern": "xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "www.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "api.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "wss.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "cpc.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "report.xydeskremote.biz.id", "custom_domain": true },
    { "pattern": "ask.xydeskremote.biz.id", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "UNIQUE_DOWNLOADS", "id": "909d51530b7d4e6b8ada61ec59a3e3d3" }
  ],
  "d1_databases": [
    {
      "binding": "XYDESK_DB",
      "database_name": "xydesk-news",
      "database_id": "7ffccd9e-3432-47bf-b3e7-7492cbe56ea2"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACTIVE_SESSIONS", "class_name": "ActiveSessions" },
      { "name": "COMMUNITY_JOKES", "class_name": "CommunityJokes" },
      { "name": "FEEDBACK_BOARD", "class_name": "FeedbackBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ActiveSessions"] },
    { "tag": "v4", "new_sqlite_classes": ["FeedbackBoard"] }
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // KUOTA WORKERS (Error 1027 = 100.000 request/hari per AKUN, reset 00:00 UTC).
    // Static assets TIDAK menghitung kuota, TAPI setiap path yang ada di
    // run_worker_first memanggil Worker dulu → ikut dihitung. Karena itu
    // daftar ini harus berisi HANYA path yang benar-benar butuh logika dinamis
    // (redirect aset rilis, skrip unduhan, routing host). File statis murni
    // seperti onmic.ps1 / onmic-linux.sh sudah dikeluarkan dari daftar.
    // Catatan: "/" dan "/index.html" masih butuh Worker untuk routing host
    // (apex→www, api/wss/cpc→health, report/ask→feedback). Untuk menghapus
    // dua entry terbesar itu, pindahkan routing host ke Cloudflare Redirect
    // Rules + Route terpisah, lalu hapus keduanya dari sini.
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/arm64-v8a.apk",
      "/armeabi-v7a.apk",
      "/x86_64.apk",
      "/universal.apk",
      "/SHA256SUMS.txt",
      "/XyDesk-Remote-Host-Agent-win64.zip",
      "/XyDeskRemoteHost.exe",
      "/XyDeskRemoteHost-Standalone.exe",
      "/XyDesk-Host.exe",
      "/xydesk_quic.dll",
      "/xydesk_host_core.dll",
      "/XyDesk-x64.exe",
      "/XyDesk-x64.msi",
      "/XyDesk-Remote-arm64-v8a.apk",
      "/XyDesk-Remote-armeabi-v7a.apk",
      "/XyDesk-Remote-x86_64.apk",
      "/XyDesk-Remote-universal.apk",
      "/XyDesk-RemoteUniversal.apk",
      "/XyDesk-arm64-v8a.apk",
      "/XyDesk-armeabi-v7a.apk",
      "/XyDesk.apk",
      "/_qa/*",
      "/host",
      "/host.ps1",
      "/agent.ps1",
      "/agent.bat",
      "/XyDeskHost-Setup.bat"
    ]
  }
}
