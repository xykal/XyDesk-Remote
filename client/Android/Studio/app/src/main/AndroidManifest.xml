<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Android 11+ package visibility for launching the user's Spotify app. -->
    <queries>
        <package android:name="com.spotify.music" />
        <!-- Mulai Android 11 kueri paket disaring: tanpa deklarasi intent ini,
             daftar pemutar yang membuka pustaka (MediaBrowserService) selalu
             kosong walau aplikasinya terpasang. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- Network/permission requirements are declared by the freeRDPCore
         library manifest (INTERNET, RECORD_AUDIO, CAMERA, ...) and merged
         into this app automatically. -->

    <!-- Sesi remote adalah pekerjaan yang sedang dilihat user: dijalankan
         sebagai foreground service supaya Android tidak mematikan proses
         begitu app dipindah ke latar. Tipe specialUse dipakai karena kasus
         ini tidak masuk kategori foreground bawaan. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name="id.xydesk.remote.XyApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:resizeableActivity="true">

        <!-- AdMob: wajib untuk play-services-ads (fitur RDP Gratis). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7140410806476728~5239237352" />

        <service
            android:name="id.xydesk.remote.XySessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="remote desktop session" />
        </service>

        <!-- Read only Spotify's active media session after the user explicitly enables access. -->
        <service
            android:name="id.xydesk.remote.ui.SpotifyNotificationListenerService"
            android:label="@string/spotify_media_listener_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Launcher: home Compose (daftar perangkat + koneksi + target Share ke PC) -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskHomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Kirim ke PC (XyDesk)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Layar sesi XyDesk (surface + kontrol Compose). -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskSessionActivity"
            android:exported="false"
            android:label="Sesi RDP"
            android:theme="@style/Theme.XyDeskHome"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout" />

        <!-- FileProvider buat share screenshot -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
