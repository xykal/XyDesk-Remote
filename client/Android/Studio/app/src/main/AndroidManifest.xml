<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- Network/permission requirements are declared by the freeRDPCore
         library manifest (INTERNET, RECORD_AUDIO, CAMERA, ...) and merged
         into this app automatically. -->

    <!-- Sesi remote adalah pekerjaan yang sedang dilihat user: dijalankan
         sebagai foreground service supaya Android tidak mematikan proses
         begitu app dipindah ke latar. Tipe specialUse dipakai karena kasus
         ini tidak masuk kategori foreground bawaan. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Pastikan izin sensitif yang memicu blokir keras Google Play Protect
         Enhanced Fraud Protection (tanpa opsi "Tetap instal" / "Scan") tidak
         pernah ikut ter-merge dari modul/library mana pun. -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application
        android:name="id.xydesk.remote.XyApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:resizeableActivity="true">

        <!-- AdMob: wajib untuk play-services-ads (fitur RDP Gratis). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7140410806476728~5239237352" />

        <!-- OneSignal v5: intersep push Chat Global untuk dirender sebagai
             MessagingStyle (gaya WhatsApp) lengkap dengan tombol Balas
             langsung (RemoteInput) dan Tandai Dibaca. -->
        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="id.xydesk.remote.push.ChatNotificationExtension" />

        <receiver
            android:name="id.xydesk.remote.push.ChatReplyReceiver"
            android:exported="false" />

        <service
            android:name="id.xydesk.remote.XySessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="remote desktop session" />
        </service>


        <!-- Launcher: home Compose (daftar perangkat + koneksi + target Share ke PC + Deep Link OAuth GitHub) -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboard|keyboardHidden|navigation|touchscreen|screenSize|smallestScreenSize|density|screenLayout|uiMode|fontScale|layoutDirection|colorMode|mcc|mnc">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Kirim ke PC (XyDesk)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="GitHub OAuth Callback (XyDesk)">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xydesk" android:host="github-auth" />
            </intent-filter>
        </activity>

        <!-- Layar sesi XyDesk (surface + kontrol Compose). -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskSessionActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="Sesi RDP"
            android:theme="@style/Theme.XyDeskHome"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|keyboard|keyboardHidden|navigation|touchscreen|screenSize|smallestScreenSize|density|screenLayout|uiMode|fontScale|layoutDirection|colorMode|mcc|mnc" />

        <!-- Sesi PC-stream produksi (host XyDesk via hub signaling). -->
        <activity
            android:name="id.xydesk.remote.ui.PcStreamSessionActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="Sesi PC Stream"
            android:theme="@style/Theme.XyDeskHome"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|keyboard|keyboardHidden|navigation|touchscreen|screenSize|smallestScreenSize|density|screenLayout|uiMode|fontScale|layoutDirection|colorMode|mcc|mnc" />

        <!-- Konfigurasi widget quick-connect: dipanggil launcher saat widget
             dipasang, karena itu harus exported. -->
        <activity
            android:name="id.xydesk.remote.ui.XyWidgetConfigActivity"
            android:exported="true"
            android:label="Pilih Perangkat Widget"
            android:theme="@style/Theme.XyDeskHome" />

        <!-- Widget quick-connect homescreen: satu tap = langsung connect. -->
        <receiver
            android:name="id.xydesk.remote.ui.XyQuickConnectWidgetProvider"
            android:exported="false"
            android:label="XyDesk Quick Connect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_connect_info" />
        </receiver>

        <!-- FileProvider buat share screenshot -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Default Push Notification Icon (24dp Full-Bleed Vector XyDesk) untuk FCM & OneSignal -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_xydesk" />
        <meta-data
            android:name="com.onesignal.NotificationAccentColor.DEFAULT"
            android:value="FF6366F1" />

    </application>

</manifest>
