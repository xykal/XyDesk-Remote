<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Network/permission requirements are declared by the freeRDPCore
         library manifest (INTERNET, RECORD_AUDIO, CAMERA, ...) and merged
         into this app automatically. -->

    <application
        android:name="id.xydesk.remote.XyApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:resizeableActivity="true">

        <!-- Launcher: home Compose (daftar perangkat + koneksi) -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskHomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layar sesi XyDesk (surface + kontrol Compose). Hanya dibuka dari
             home lewat connectIntent() — bukan launcher, bukan exported. -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskSessionActivity"
            android:exported="false"
            android:label="Sesi RDP"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout" />

        <!-- FileProvider buat share screenshot -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
