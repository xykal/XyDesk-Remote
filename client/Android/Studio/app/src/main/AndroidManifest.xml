<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Network/permission requirements are declared by the freeRDPCore
         library manifest (INTERNET, RECORD_AUDIO, CAMERA, ...) and merged
         into this app automatically. -->

    <application
        android:name="id.xydesk.remote.XyApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true">

        <!-- Cloud RDP (GitHub) — login, create repo, auto-setup, auto-connect -->
        <activity
            android:name="id.xydesk.remote.cloud.CloudRdpActivity"
            android:exported="false"
            android:label="Cloud RDP (GitHub)"
            android:theme="@style/Theme.Main"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout" />

        <!-- M0: connection screen (XyDesk UI). The RDP session itself is
             rendered by com.freerdp.freerdpcore.presentation.SessionActivity
             until M1/M2 replace it with the native XyDesk session surface. -->
        <activity
            android:exported="true"
            android:name="id.xydesk.remote.MainActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.Main"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
