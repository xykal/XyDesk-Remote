<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Network/permission requirements are declared by the freeRDPCore
         library manifest (INTERNET, RECORD_AUDIO, CAMERA, ...) and merged
         into this app automatically. -->

    <application
        android:name="id.xydesk.remote.XyApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true">

        <!-- M1.2: home Compose (launcher) — favorit + form koneksi + Cloud RDP -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskHomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cloud RDP (GitHub) — login, create repo, auto-setup, auto-connect -->
        <activity
            android:name="id.xydesk.remote.cloud.CloudRdpActivity"
            android:exported="false"
            android:label="Cloud RDP (GitHub)"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout" />

        <!-- M2: layar sesi XyDesk (surface Compose + HUD). Dijalankan
             dari home XyDesk (connectIntent); bukan launcher. -->
        <activity
            android:name="id.xydesk.remote.ui.XyDeskSessionActivity"
            android:exported="false"
            android:label="Sesi RDP"
            android:theme="@style/Theme.XyDeskHome"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout" />

        <!-- M2.5: FileProvider buat share screenshot -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
