<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cloud RDP (GitHub)"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bebas: punya RDP sendiri? Pakai menu Connect (IP + user + pass). Belum punya? Login akun GitHub KAMU, isi form di bawah, app bikin repo PUBLIC otomatis di akun kamu + jalanin script RDP via Tailscale. Tidak ada yg numpang di akun developer."
            android:textSize="12sp"
            android:alpha="0.7" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.25"
            android:background="?android:attr/listDivider" />

        <Button
            android:id="@+id/btn_cloud_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login dengan GitHub" />

        <TextView
            android:id="@+id/txt_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Belum login"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nama (akan jadi nama repo GitHub kamu)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_repo_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="misal: desk-gaming-01"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nama user RDP (opsional)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_rdp_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="default: xydesk"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Password RDP (opsional — WAJIB KUAT)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_rdp_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="kosongkan = auto-generate"
            android:inputType="textPassword"
            android:singleLine="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Min 12 karakter, campur huruf besar/kecil + angka + simbol (!@#$%^&amp;*._-). Tanpa spasi/kutip. Jangan mengandung nama user."
            android:textSize="10sp"
            android:alpha="0.6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tailscale auth key (opsional)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/input_ts_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="tskey-auth-... (kosongkan = pakai key di runner)"
            android:inputType="textPassword"
            android:singleLine="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pre-auth key dari Tailscale admin console (tailscale.com/admin/keys). Di-mask otomatis, tidak masuk log."
            android:textSize="10sp"
            android:alpha="0.6" />

        <Button
            android:id="@+id/btn_cloud_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Create &amp; Setup (otomatis)" />

        <ProgressBar
            android:id="@+id/cloud_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_cloud_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.25"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:alpha="0.65"
            android:text="Cara kerja:\n• Login pakai akun GitHub KAMU — repo PUBLIC dibuat di akun kamu, workflow jalan di akun kamu, mesin RDP = host milik kamu (self-hosted runner 'xydesk-win').\n• Rahasia (password RDP & Tailscale key) di-enskripsi ke kunci host sebelum dikirim — TIDAK lewat input workflow, aman walau repo public.\n• Kredensial balik ke app juga ter-enskripsi end-to-end — tidak pernah disimpan di HP.\n\nPrasyarat (sekali saja per mesin):\n• Host Windows (Pro/Enterprise/Server) terdaftar sbg self-hosted runner GitHub label 'xydesk-win' + Tailscale terpasang. JANGAN pakai runner GitHub-hosted (windows-latest) sbg mesin RDP — melanggar ketentuan Actions & bikin akun kena suspend\n• Tailscale di HP login ke tailnet yang sama" />

    </LinearLayout>
</ScrollView>
