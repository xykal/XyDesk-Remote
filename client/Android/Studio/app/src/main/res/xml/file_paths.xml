<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Lokasi screenshot lama (Android 7-9) untuk FileProvider (ACTION_SEND). -->
    <external-files-path
        name="screenshots"
        path="screenshots/" />

    <!-- Folder yang di-redirect jadi drive 'XyDesk' di PC. File yang diterima
         dari PC perlu URI content:// sebelum bisa dibuka/dibagikan aplikasi
         lain; FileProvider hanya mau melayani path yang dideklarasikan di sini. -->
    <external-files-path
        name="share"
        path="Share/" />

    <!-- APK hasil unduhan update dalam aplikasi (downloadApkInApp menulis ke
         externalCacheDir/updates) dibuka lewat FileProvider oleh installer. -->
    <external-cache-path
        name="updates"
        path="updates/" />
    <cache-path
        name="updates-int"
        path="updates/" />
</paths>
